{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Machine Variant Profile",
  "type": "object",
  "required": ["type", "name", "inherits", "nozzle_diameter", "gcode_flavor", "host_type"],
  "properties": {
    "type": {"const": "machine"},
    "name": {"type": "string"},
    "inherits": {"type": "string"},
    "nozzle_diameter": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^0\\.4$"}},
    "gcode_flavor": {"const": "klipper"},
    "host_type": {"const": "klipper"}
  }
}
