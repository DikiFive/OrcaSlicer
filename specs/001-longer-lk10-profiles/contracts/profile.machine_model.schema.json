{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MachineModel Profile",
  "type": "object",
  "required": ["type", "name", "printable_area"],
  "properties": {
    "type": {"const": "machine_model"},
    "name": {"type": "string"},
    "inherits": {"type": ["string", "null"]},
    "printable_area": {"type": "string", "pattern": "^\\d+x\\d+$"},
    "printable_height": {"type": ["number", "string"]},
    "bed_model": {"type": ["string", "null"]},
    "bed_texture": {"type": ["string", "null"]},
    "default_print_profile": {"type": "string"},
    "default_filament_profile": {"type": "string"}
  }
}
